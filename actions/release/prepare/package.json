{
	"name": "release-prepare",
	"version": "1.0.0",
	"private": true,
	"description": "Compute release versions and notes, and optionally save a GitHub draft",
	"type": "module",
	"scripts": {
		"test": "node --test",
		"test:watch": "node --test --watch",
		"test:ci": "node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test"
	},
	"author": "hoverkraft",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"release-drafter": "7.10.0",
		"semver": "7.8.5",
		"yaml": "2.9.1"
	}
}
